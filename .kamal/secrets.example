# Copy to .kamal/secrets and fill in. Never commit .kamal/secrets.
#
# GHCR: GitHub PAT with read:packages + write:packages
KAMAL_REGISTRY_PASSWORD=

# Required — users sign in via Settings → Account → Server access
# Generate: openssl rand -base64 32
SIDECAR_TOKEN=

# Required for agent chat — each user saves their own key in Settings → Cursor (not a deploy secret)
# CURSOR_API_KEY=

# Optional — Gemini Lookup in the app
GEMINI_API_KEY=

# Optional — Linear OAuth (otherwise seed tokens under BACKSTER_DATA_DIR on the volume)
# LINEAR_OAUTH_CLIENT_ID=
# LINEAR_OAUTH_CLIENT_SECRET=
